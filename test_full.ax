// =============================================================================
// Axiom Language Showcase (現在実装完了している機能のデモ)
// =============================================================================

// 1. ECS コンポーネント定義 (DOD レジストリに格納)
component Position {
    x: float32,
    y: float32,
}

component Velocity {
    vx: float32,
    vy: float32,
}

// 2. 関数定義と型注釈 (引数・戻り値)
fun is_alive(hp: int32) -> bool {
    val alive: bool = hp > 0;
    return alive;
}

// 3. 算術演算と関数呼び出しの組み合わせ
fun compute_next_position(current: float32, velocity: float32, delta_time: float32) -> float32 {
    val distance: float32 = velocity * delta_time;
    val next_pos: float32 = current + distance;
    return next_pos;
}

// 4. while ループと複合代入演算子 (+=, -=, *=, /=)
fun reset_counter() {
    var timer: int32 = 0;
    while timer < 10 {
        timer += 1;
    }
    return;
}

// 5. 配列システム（固定長配列・空配列初期化・SoA配列・インデックス参照・要素代入）
fun test_array_system() {
    // 固定長配列の宣言と初期化
    val scores: [int32; 3] = [100, 200, 300];

    // 空配列初期化（ゼロ初期化）
    val buffer: [float32; 4] = [];

    // SoA 配列型の宣言
    val particles: soa [Position; 1000] = [];

    // インデックス参照 (R-Value)
    val first_score: int32 = scores[0];

    // 配列要素への代入 (L-Value) & 複合代入
    scores[0] = 999;
    scores[0] += 1;

    return;
}

// 6. ECS メンバアクセス・代入・論理演算・if文の統合
fun update_physics() {
    val dt: float32 = 0.016;

    // ECS コンポーネントメンバアクセス (R-Value)
    val cur_x: float32 = Position.x;
    val cur_y: float32 = Position.y;
    val vel_x: float32 = Velocity.vx;
    val vel_y: float32 = Velocity.vy;

    // ECS コンポーネントメンバへの代入 (L-Value) & 複合代入
    Position.x = 0.0;
    Position.y = 0.0;
    Position.x += 10.0;

    // 関数呼び出し (call_expression) の検証
    val next_x: float32 = compute_next_position(cur_x, vel_x, dt);
    val next_y: float32 = compute_next_position(cur_y, vel_y, dt);

    // 比較演算・論理演算 (and, or, not)
    val is_in_boundary: bool = next_x >= 0.0 and next_x <= 1920.0;
    val is_grounded: bool = next_y == 0.0;
    val is_falling: bool = not is_grounded;

    // if 文による分岐制御
    if is_in_boundary {
        var step: int32 = 0;
        step = step + 1;
    }

    // 別関数の呼び出し
    val alive: bool = is_alive(100);

    return;
}

